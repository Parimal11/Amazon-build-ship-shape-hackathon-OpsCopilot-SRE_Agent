@'
# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Java and Maven
**/target/
*.class

# Python
**/.venv/
**/venv/
**/__pycache__/
*.py[cod]

# IDE and OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Logs
*.log

# Open-source testing workload — keep local, don't commit
/spring-petclinic-microservices/
'@ | Set-Content -Path .gitignore -Encoding UTF8
